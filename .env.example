VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Push Notifications (VAPID Keys)
VITE_VAPID_PUBLIC_KEY=sua-vapid-public-key

# Timezone
VITE_TIMEZONE=America/Sao_Paulo

# App
VITE_APP_NAME=TVG Flow
VITE_APP_URL=http://localhost:5173

# Login com Google (SSO)
# Desligado por padrao. Ligue APENAS depois de habilitar o provedor Google em
# Authentication > Providers no Supabase (client ID + secret) e de cadastrar a
# URL de retorno <origem>/login. Sem essa configuracao o botao aparece e falha.
VITE_ENABLE_GOOGLE_SSO=false
